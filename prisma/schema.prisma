generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime? @map("email_verified")
  password      String?
  image         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  accounts      Account[]
  bookmarks     Bookmark[]
  sessions      Session[]
  watchHistory  WatchHistory[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type               String
  provider           String
  providerAccountId  String  @map("provider_account_id")
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model WatchHistory {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  animeId   String   @map("anime_id")
  episodeId Int      @map("episode_id")
  progress  Float
  updatedAt DateTime @default(now()) @map("updated_at")
  anime     Anime    @relation(fields: [animeId], references: [id], onDelete: Cascade)
  episode   Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, animeId, episodeId])
  @@map("watch_history")
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  animeId   String   @map("anime_id")
  createdAt DateTime @default(now()) @map("created_at")
  anime     Anime    @relation(fields: [animeId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, animeId])
  @@map("bookmarks")
}

model Anime {
  id           String         @id
  title        String
  url          String?        @unique
  image        String?
  type         String?        
  scheduledDay String?        @map("scheduled_day")
  season       String?        
  updatedAt    DateTime       @default(now()) @map("updated_at")
  bookmarks    Bookmark[]
  episodes     Episode[]
  watchHistory WatchHistory[]

  @@map("anime")
}

model Episode {
  id            Int            @id @default(autoincrement())
  animeId       String         @map("anime_id")
  title         String
  url           String         @unique
  streamData    String?        @map("stream_data")
  episodeList   String?        @map("episode_list")
  downloadLinks String?        @map("download_links")
  updatedAt     DateTime       @default(now()) @map("updated_at")
  anime         Anime          @relation(fields: [animeId], references: [id])
  watchHistory  WatchHistory[]

  @@index([animeId])
  @@map("episodes")
}
